PORT=8080
DATA_DIR=/data
# Generate independent random secrets. Never commit actual values.
NUTRI_SERVICE_TOKEN=CHANGE_ME_TO_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
N8N_REGISTRATION_WEBHOOK=https://YOUR-N8N/webhook/nutri-app-registration
N8N_APP_WEBHOOK_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
